{
  "name": "vitor-research-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare:data",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "pretest": "npm run prepare:data",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "worker:dev": "npm run prepare:data && wrangler dev",
    "worker:deploy": "npm run prepare:data && wrangler deploy"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "gsap": "^3.13.0",
    "maplibre-gl": "^6.9.0",
    "minisearch": "^7.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.15.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.131.2"
  }
}
